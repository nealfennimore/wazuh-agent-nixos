new file mode 100644
index 0000000000..f236dd6ddb
--- /dev/null
+++ b/src/data_provider/src/packages/packageLinuxNixParserHelper.h
@@ -0,0 +1,310 @@
+/*
+ * Wazuh SYSINFO
+ * Copyright (C) 2015, Wazuh Inc.
+ * October 04, 2026.
+ *
+ * This program is free software; you can redistribute it
+ * and/or modify it under the terms of the GNU General Public
+ * License (version 2) as published by the FSF - Free Software
+ * Foundation.
+ */
+
+#ifndef _PACKAGE_LINUX_NIX_PARSER_HELPER_H
+#define _PACKAGE_LINUX_NIX_PARSER_HELPER_H
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <map>
+#include <string>
+#include <string_view>
+#include <utility>
+#include "json.hpp"
+#include "sharedDefs.h"
+
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wunused-function"
+
+namespace PackageLinuxHelper
+{
+    // A store path is <store>/<32 base-32 characters>-<name>. The hash
+    // length is fixed by Nix, so it is the anchor for the name.
+    constexpr auto NIX_STORE_HASH_LENGTH {32u};
+
+    // nixpkgs appends the output name to the store name of every output but
+    // the default one, so "openssl-3.0.14-bin" and "openssl-3.0.14-dev" are
+    // the same installed package as "openssl-3.0.14". An output name is a
+    // word, so every trailing "-<letters>" segment of the version is removed,
+    // repeatedly: "linux-6.18.44-modules-shrunk" reduces to "6.18.44".
+    // These words are version qualifiers rather than output names, and stay.
+    static const std::array<std::string_view, 10> s_nixPreReleaseWords
+    {
+        "alpha", "beta", "rc", "pre", "preview", "snapshot", "nightly",
+        "unstable", "git", "final"
+    };
+
+    // Store objects that are files rather than installed software. They
+    // carry no version that a vulnerability feed could match, and some of
+    // them, such as a kernel configuration, carry a version that is not
+    // theirs.
+    static const std::array<std::string_view, 36> s_nixSkippedExtensions
+    {
+        ".drv", ".tar.gz", ".tar.xz", ".tar.bz2", ".tar.zst", ".tgz", ".zip",
+        ".gz", ".xz", ".bz2", ".zst", ".patch", ".diff", ".conf", ".json",
+        ".toml", ".yaml", ".yml", ".xml", ".sh", ".py", ".pl", ".txt", ".pem",
+        ".crt", ".nix", ".rules", ".desktop", ".lock", ".service", ".socket",
+        ".timer", ".target", ".mount", ".path", ".whl"
+    };
+
+    // Store names that carry a version but are not a package. The NixOS
+    // system closure itself is the main one: its version is the nixpkgs
+    // revision, not a software version.
+    static const std::array<std::string_view, 2> s_nixSkippedPrefixes
+    {
+        "nixos-system-", "unit-"
+    };
+
+    // The names of Python packages from nixpkgs are "<interpreter>-<pypi
+    // name>". A few derivations under the same prefix are parts of the
+    // interpreter itself rather than PyPI packages.
+    static const std::array<std::string_view, 6> s_nixPythonNonPackages
+    {
+        "minimal", "full", "env", "debug", "tests", "wrapper"
+    };
+
+    // nixpkgs names that differ from the NVD product name for the same
+    // software. The manager looks vulnerability candidates up by product
+    // name, so a name that differs matches nothing.
+    static const std::map<std::string, std::string> s_nixProductNames
+    {
+        {"linux", "linux_kernel"},
+        {"bash-interactive", "bash"},
+        {"python3", "python"},
+        {"nodejs", "node.js"},
+    };
+
+    static bool nixEndsWith(const std::string_view value, const std::string_view suffix)
+    {
+        return value.size() >= suffix.size() &&
+               value.compare(value.size() - suffix.size(), suffix.size(), suffix) == 0;
+    }
+
+    // Nix's own rule, DrvName in libstore: the version starts at the first
+    // dash that is followed by a character that is not a letter. A name
+    // without such a dash has no version.
+    static std::pair<std::string, std::string> splitNixDrvName(const std::string& drvName)
+    {
+        for (size_t i = 0; i + 1 < drvName.size(); ++i)
+        {
+            const auto next = static_cast<unsigned char>(drvName[i + 1]);
+
+            if (drvName[i] == '-' && !std::isalpha(next))
+            {
+                return {drvName.substr(0, i), drvName.substr(i + 1)};
+            }
+        }
+
+        return {drvName, ""};
+    }
+
+    // Remove every trailing "-<output>" from a version, so the outputs of
+    // one package share one version string.
+    static std::string stripNixOutputSuffixes(std::string version)
+    {
+        bool stripped {true};
+
+        while (stripped)
+        {
+            stripped = false;
+            const auto dash = version.rfind('-');
+
+            if (dash != std::string::npos && dash > 0 && dash + 1 < version.size())
+            {
+                const std::string_view tail {version.data() + dash + 1, version.size() - dash - 1};
+                const auto isWord = std::all_of(tail.begin(), tail.end(), [](const char c)
+                {
+                    return std::isalpha(static_cast<unsigned char>(c)) != 0;
+                });
+                const auto isQualifier = std::find(s_nixPreReleaseWords.begin(), s_nixPreReleaseWords.end(), tail) !=
+                                         s_nixPreReleaseWords.end();
+
+                if (isWord && !isQualifier)
+                {
+                    version.erase(dash);
+                    stripped = true;
+                }
+            }
+        }
+
+        return version;
+    }
+
+    // "python3.13-requests" names the PyPI package "requests". The head is
+    // an interpreter name followed by digits and dots only.
+    static bool isNixPythonPackage(const std::string& name, std::string& pypiName)
+    {
+        const auto dash = name.find('-');
+
+        if (dash == std::string::npos)
+        {
+            return false;
+        }
+
+        const std::string_view head {name.data(), dash};
+        const std::string_view rest {name.data() + dash + 1, name.size() - dash - 1};
+        std::string_view digits;
+
+        if (head.compare(0, 6, "python") == 0)
+        {
+            digits = head.substr(6);
+        }
+        else if (head.compare(0, 4, "pypy") == 0)
+        {
+            digits = head.substr(4);
+        }
+        else
+        {
+            return false;
+        }
+
+        const auto onlyVersionChars = std::all_of(digits.begin(), digits.end(), [](const char c)
+        {
+            return std::isdigit(static_cast<unsigned char>(c)) || c == '.';
+        });
+
+        if (!onlyVersionChars || rest.empty())
+        {
+            return false;
+        }
+
+        if (std::find(s_nixPythonNonPackages.begin(), s_nixPythonNonPackages.end(), rest) !=
+                s_nixPythonNonPackages.end())
+        {
+            return false;
+        }
+
+        pypiName = std::string {rest};
+        return true;
+    }
+
+    /**
+     * @brief Turns one line of `nix-store --query --requisites` into a
+     *        package row.
+     *
+     * The line is a store path. Its name part follows the nixpkgs convention
+     * "<pname>-<version>[-<output>]", which is the only information the
+     * store carries about an installed package: no vendor, no description,
+     * no install time and no record of patches that nixpkgs applied.
+     *
+     * @param line         One store path, with or without surrounding
+     *                     whitespace.
+     * @param architecture The machine architecture to record. The store path
+     *                     does not carry it.
+     * @return The package row, or an empty object when the line is not a
+     *         versioned package.
+     */
+    static nlohmann::json parseNixStorePath(const std::string& line, const std::string& architecture)
+    {
+        nlohmann::json packageInfo;
+
+        const auto first = line.find_first_not_of(" \t\r\n");
+
+        if (first == std::string::npos)
+        {
+            return packageInfo;
+        }
+
+        const auto last = line.find_last_not_of(" \t\r\n");
+        const std::string storePath {line.substr(first, last - first + 1)};
+
+        const auto slash = storePath.rfind('/');
+
+        if (slash == std::string::npos || slash == 0)
+        {
+            return packageInfo;
+        }
+
+        const std::string storeName {storePath.substr(slash + 1)};
+
+        // <hash>-<name>, and the hash is base-32 without padding.
+        if (storeName.size() <= NIX_STORE_HASH_LENGTH + 1 || storeName[NIX_STORE_HASH_LENGTH] != '-')
+        {
+            return packageInfo;
+        }
+
+        const auto hashIsBase32 = std::all_of(storeName.begin(), storeName.begin() + NIX_STORE_HASH_LENGTH,
+                                              [](const char c)
+        {
+            return std::isdigit(static_cast<unsigned char>(c)) || std::islower(static_cast<unsigned char>(c));
+        });
+
+        if (!hashIsBase32)
+        {
+            return packageInfo;
+        }
+
+        const std::string drvName {storeName.substr(NIX_STORE_HASH_LENGTH + 1)};
+
+        for (const auto& extension : s_nixSkippedExtensions)
+        {
+            if (nixEndsWith(drvName, extension))
+            {
+                return packageInfo;
+            }
+        }
+
+        for (const auto& prefix : s_nixSkippedPrefixes)
+        {
+            if (drvName.compare(0, prefix.size(), prefix) == 0)
+            {
+                return packageInfo;
+            }
+        }
+
+        auto [name, version] = splitNixDrvName(drvName);
+        version = stripNixOutputSuffixes(version);
+
+        if (name.empty() || version.empty())
+        {
+            return packageInfo;
+        }
+
+        std::transform(name.begin(), name.end(), name.begin(), [](const unsigned char c)
+        {
+            return std::tolower(c);
+        });
+
+        std::string format {"nix"};
+        std::string pypiName;
+
+        if (isNixPythonPackage(name, pypiName))
+        {
+            name = pypiName;
+            format = "pypi";
+        }
+        else if (const auto product = s_nixProductNames.find(name); product != s_nixProductNames.end())
+        {
+            name = product->second;
+        }
+
+        packageInfo["name"] = name;
+        packageInfo["version"] = version;
+        packageInfo["format"] = format;
+        packageInfo["architecture"] = architecture;
+        packageInfo["location"] = storePath;
+        packageInfo["description"] = drvName;
+        packageInfo["source"] = "nixpkgs";
+        packageInfo["vendor"] = UNKNOWN_VALUE;
+        packageInfo["install_time"] = UNKNOWN_VALUE;
+        packageInfo["groups"] = UNKNOWN_VALUE;
+        packageInfo["priority"] = UNKNOWN_VALUE;
+        packageInfo["size"] = 0;
+        // The multiarch field won't have a default value
+
+        return packageInfo;
+    }
+}
+
+#pragma GCC diagnostic pop
+
+#endif // _PACKAGE_LINUX_NIX_PARSER_HELPER_H
