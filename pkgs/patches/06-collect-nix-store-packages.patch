@@ -0,0 +1,68 @@
+/*
+ * Wazuh SYSINFO
+ * Copyright (C) 2015, Wazuh Inc.
+ * October 04, 2026.
+ *
+ * This program is free software; you can redistribute it
+ * and/or modify it under the terms of the GNU General Public
+ * License (version 2) as published by the FSF - Free Software
+ * Foundation.
+ */
+
+#include <fstream>
+#include <map>
+#include <string>
+#include <sys/utsname.h>
+#include "json.hpp"
+#include "packageLinuxNixParserHelper.h"
+
+void getNixInfo(const std::string& fileName, std::function<void(nlohmann::json&)> callback)
+{
+    std::ifstream closure(fileName);
+
+    if (!closure.is_open())
+    {
+        return;
+    }
+
+    struct utsname uts {};
+    const std::string architecture {uname(&uts) == 0 ? uts.machine : UNKNOWN_VALUE};
+
+    // One row per installed package, not per store path. A package with
+    // several outputs, or two builds of the same version, is listed once,
+    // and the shortest store path wins because it is the one without an
+    // output suffix.
+    std::map<std::string, nlohmann::json> packages;
+    std::string line;
+
+    while (std::getline(closure, line))
+    {
+        auto packageInfo = PackageLinuxHelper::parseNixStorePath(line, architecture);
+
+        if (packageInfo.empty())
+        {
+            continue;
+        }
+
+        const auto key = packageInfo.at("name").get<std::string>() + "|" +
+                         packageInfo.at("version").get<std::string>() + "|" +
+                         packageInfo.at("format").get<std::string>();
+
+        const auto it = packages.find(key);
+
+        if (it == packages.end())
+        {
+            packages.emplace(key, std::move(packageInfo));
+        }
+        else if (packageInfo.at("location").get<std::string>().size() <
+                 it->second.at("location").get<std::string>().size())
+        {
+            it->second = std::move(packageInfo);
+        }
+    }
+
+    for (auto& [key, packageInfo] : packages)
+    {
+        callback(packageInfo);
+    }
+}
